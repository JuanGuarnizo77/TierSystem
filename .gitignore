# ==========================================
# TierSystem - .gitignore (Seguridad y Producción)
# ==========================================

# --- Entornos Virtuales (Python) ---
venv/
venv_linux/
.venv/
env/
ENV/
env.bak/
venv.bak/

# --- Variables de Entorno, Credenciales y Secretos ---
.env
.env.*
!.env.example
*.pem
*.key
*.cert
*.crt
secrets.json

# --- Base de Datos Local y Volcados ---
*.sqlite3
*.sqlite3-journal
db.sqlite3
*.db
*.sql
*.dump

# --- Caché y Bytecode de Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# --- Django Media y Archivos Estáticos Generados ---
media/
staticfiles/
*.log

# --- Archivos de Configuración de IDEs y Editores ---
.vscode/
.idea/
*.swp
*.swo
*.sublime-project
*.sublime-workspace
.DS_Store
Thumbs.db

# --- Archivos de pruebas / Cobertura ---
.tox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
.hypothesis/
.pytest_cache/

# --- Documentación interna o sensible ---
documentacion/historias de usuario/
documentacion/MANUAL_DE_ESTUDIO_COMPLETO_TIERSYSTEM.md
documentacion/MANUAL_DE_ESTUDIO_COMPLETO_TIERSYSTEM_EN.md


# --- Archivos temporales de esquemas/APIs ---
tiersystem_schema.json
