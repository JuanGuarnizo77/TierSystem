# ==========================================
# Variables de Entorno - TierSystem
# Copiar este archivo a .env y configurar valores locales
# ==========================================

# Clave secreta de Django
SECRET_KEY=django-insecure-dummy-key-for-dev

# Motor de Base de Datos: 'mysql' (Laragon/XAMPP/Producción) o 'sqlite' (Desarrollo local rápido)
DB_ENGINE=sqlite

# Configuración si DB_ENGINE=mysql:
DB_NAME=tiersystem_db
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# Correo (Opcional para recuperación de contraseñas)
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# Llave de telemetría de sensores ESP32
SENSOR_API_KEY=tiersystem-sensor-key-dev

# Inteligencia Artificial (Google Gemini)
GEMINI_API_KEY=
