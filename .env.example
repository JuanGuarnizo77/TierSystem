# =============================================================================
# TierSystem — Plantilla de variables de entorno
# Copia este archivo a .env y rellena los valores reales.
#
# Para SQLite (desarrollo, por defecto): establece DB_ENGINE=sqlite u omítelo.
# Para MySQL (producción): establece DB_ENGINE=mysql y completa las vars DB_*.
# =============================================================================

# ── Django core ──────────────────────────────────────────────────────────────
SECRET_KEY=cambiar-esto-por-una-clave-secreta-segura
DEBUG=True
# Lista separada por comas. En producción pon el dominio real, ej: midominio.com,www.midominio.com
ALLOWED_HOSTS=localhost,127.0.0.1

# ── Base de datos ─────────────────────────────────────────────────────────────
# Opciones: sqlite (defecto) | mysql
DB_ENGINE=sqlite

# Las variables DB_* sólo aplican cuando DB_ENGINE=mysql
DB_NAME=tiersystem_db
DB_USER=root
DB_PASSWORD=your_password_here
DB_HOST=127.0.0.1
DB_PORT=3306

# ── Correo electrónico (SMTP Gmail) ──────────────────────────────────────────
# Si se omiten, Django usará el backend de consola (imprime en terminal).
EMAIL_HOST_USER=tu_correo@gmail.com
EMAIL_HOST_PASSWORD=your_app_password_here

# ── API de sensores ───────────────────────────────────────────────────────────
# En producción esta clave es obligatoria. En desarrollo se usa un valor por defecto.
SENSOR_API_KEY=tiersystem-sensor-key-dev
